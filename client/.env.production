# API origin the built SPA calls. Loaded by `vite build` (production mode).
VITE_ENCLAVE_URL=https://enclave.vtxos.com

# TEMPORARY — skips attestation verification (the enclave's /v1 + /enclave
# routes aren't CORS-reachable cross-origin yet). Delete this line to re-enable.
VITE_SKIP_ATTESTATION=true
